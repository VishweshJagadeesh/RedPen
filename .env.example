# Local development uses SQLite. Production (Vercel) uses Postgres:
#   DATABASE_URL="postgresql://user:pass@host:5432/redpen?sslmode=require"
DATABASE_URL="file:./dev.db"

# AI. Leave ANTHROPIC_API_KEY empty to run fully in mock mode.
ANTHROPIC_API_KEY=""
# AI_MODE=live|mock — defaults to live when ANTHROPIC_API_KEY is set, otherwise mock.
AI_MODE=""
GRADING_MODEL="claude-sonnet-5-5"
PLANNING_MODEL="claude-sonnet-5-5"

# File storage: "local" (default, ./.data/uploads) or "blob" (Vercel Blob; needs BLOB_READ_WRITE_TOKEN).
STORAGE_DRIVER="local"
BLOB_READ_WRITE_TOKEN=""

# Optional tuning
MOCK_LATENCY_MS="120"
CONFIDENCE_HIGH="0.85"
CONFIDENCE_MEDIUM="0.60"
