{
  "name": "redpen",
  "version": "0.1.0",
  "private": true,
  "description": "RedPen: grade handwritten tests, diagnose concept gaps, and act on them.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test --trace off",
    "db:push": "prisma db push --skip-generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "prisma db push --skip-generate && tsx prisma/seed.ts",
    "db:provider": "node scripts/select-db-provider.mjs",
    "samples:generate": "tsx scripts/generate-samples.ts",
    "eval": "tsx scripts/eval.ts",
    "postinstall": "node scripts/select-db-provider.mjs && prisma generate",
    "vercel-build": "node scripts/select-db-provider.mjs && prisma generate && prisma db push --skip-generate && next build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.13.0",
    "@prisma/client": "6.19.3",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@vercel/blob": "^2.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.555.0",
    "next": "15.5.29",
    "prisma": "6.19.3",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "recharts": "^3.11.1",
    "tailwind-merge": "^3.4.0",
    "tsx": "^4.21.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@fontsource/caveat": "^5.2.8",
    "@fontsource/kalam": "^5.2.8",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.1.18",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.29",
    "tailwindcss": "4.1.18",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
